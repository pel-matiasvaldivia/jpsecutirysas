# Copiar como .env y completar. El .env NO se sube al repositorio.

# --- Correo al que llegan las consultas del formulario ---
MAIL_TO=Jpseguridadsas@gmail.com

# --- Servidor SMTP que envía ---
# Para Gmail hace falta una "contraseña de aplicación" (no la del mail):
# myaccount.google.com -> Seguridad -> Verificación en 2 pasos -> Contraseñas de aplicaciones
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=Jpseguridadsas@gmail.com
SMTP_PASSWORD=
MAIL_FROM=Jpseguridadsas@gmail.com

# --- Opcionales ---
# HTTP_PORT=80
# IMAGE_WEB=ghcr.io/pel-matiasvaldivia/jpsecutirysas:latest
# IMAGE_API=ghcr.io/pel-matiasvaldivia/jpsecutirysas/api:latest
